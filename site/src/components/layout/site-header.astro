---
import { ui, type Lang } from "@/lib/issue";
import ThemeButton from "./theme-button.astro";

type Props = { lang: Lang; switchHref?: string };
const { lang, switchHref } = Astro.props;
const t = ui(lang);
const base = import.meta.env.BASE_URL;
const home = lang === "zh" ? `${base}zh/` : base;
const otherLang = lang === "zh" ? "en" : "zh";
const path = Astro.url.pathname;
const isAbout = path.startsWith(`${base}about`);
const isHome = path === home;
---
<header class="site-header">
  <div class="wrap">
    <a href={home} class="brand" aria-label={t.siteName}>
      <span class="brand-mark" aria-hidden="true">AI</span>
      <span class="brand-name">{t.siteName}</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href={home} aria-current={isHome ? "page" : undefined}>{t.home}</a>
      <a href={`${home}#archive`}>{t.archive}</a>
      <a href={`${base}about/`} aria-current={isAbout ? "page" : undefined}>{t.about}</a>
      <a href={`${base}rss.xml`} class="rss">RSS</a>
    </nav>
    <div class="tools">
      {switchHref && (
        <a
          href={switchHref}
          class="lang"
          lang={otherLang === "zh" ? "zh-CN" : "en"}
        >{t.switchLang}</a>
      )}
      <ThemeButton label={lang === "zh" ? "切换深色模式" : "Toggle dark mode"} />
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 40; background: hsl(var(--background) / 0.88); backdrop-filter: saturate(160%) blur(12px); -webkit-backdrop-filter: saturate(160%) blur(12px); border-bottom: 1px solid hsl(var(--border)); }
  .wrap { max-width: var(--page-width); margin: 0 auto; padding: 0 var(--gutter); height: 60px; display: flex; align-items: center; gap: 2rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; color: hsl(var(--foreground)); font-weight: 700; font-size: 1.05rem; white-space: nowrap; }
  .brand-mark { width: 30px; height: 30px; border-radius: 9px; background: hsl(var(--accent-ink)); color: #fff; display: grid; place-items: center; font-size: 0.76rem; font-weight: 800; letter-spacing: -0.02em; flex: none; }
  .nav { display: flex; gap: 1.5rem; margin: 0 auto; font-size: 0.92rem; }
  .nav a { color: hsl(var(--muted-foreground)); text-decoration: none; font-weight: 500; white-space: nowrap; transition: color 0.15s ease; }
  .nav a:hover, .nav a[aria-current="page"] { color: hsl(var(--foreground)); }
  .nav a[aria-current="page"] { font-weight: 700; }
  .tools { display: flex; align-items: center; gap: 0.5rem; }
  .lang { font-size: 0.8rem; font-weight: 500; color: hsl(var(--foreground)); background: hsl(var(--muted)); text-decoration: none; padding: 0.4rem 0.8rem; border-radius: 999px; white-space: nowrap; transition: background 0.15s ease; }
  .lang:hover { background: hsl(var(--border)); }
  @media (max-width: 640px) {
    .wrap { gap: 1rem; }
    .brand-name { display: none; }
    .nav { gap: 0.9rem; font-size: 0.88rem; }
    .rss { display: none; }
  }
</style>
