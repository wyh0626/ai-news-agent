---
type Props = { label?: string };
const { label = "Toggle dark mode" } = Astro.props;
---
<button type="button" class="theme-button" data-theme-toggle aria-label={label} title={label}>
  <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2.5v2.2M12 19.3v2.2M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6"></path>
  </svg>
  <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20.5 14.3A8.5 8.5 0 1 1 9.7 3.5a7 7 0 0 0 10.8 10.8z"></path>
  </svg>
</button>

<script is:inline>
  if (!window.__aiDailyThemeBound) {
    window.__aiDailyThemeBound = true;
    document.addEventListener("click", (event) => {
      const button = event.target.closest("[data-theme-toggle]");
      if (!button) return;
      const root = document.documentElement;
      const next = root.classList.contains("dark") ? "light" : "dark";
      root.classList.toggle("dark", next === "dark");
      try { localStorage.setItem("theme", next); } catch (_) {}
    });
  }
</script>

<style>
  .theme-button { display: inline-flex; align-items: center; justify-content: center; width: 2.25rem; height: 2.25rem; border-radius: 999px; color: hsl(var(--muted-foreground)); background: transparent; border: 0; cursor: pointer; transition: color 0.15s ease, background 0.15s ease; }
  .theme-button:hover { color: hsl(var(--foreground)); background: hsl(var(--muted)); }
  .theme-button:focus-visible { outline: 2px solid hsl(var(--accent-ink)); outline-offset: 2px; }
  .icon-moon { display: none; }
  :global(.dark) .icon-sun { display: none; }
  :global(.dark) .icon-moon { display: block; }
</style>
