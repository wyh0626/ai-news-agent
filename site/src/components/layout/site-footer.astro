---
import { siteConfig } from "@/config/site";
import { ui, type Lang } from "@/lib/issue";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = ui(lang);
const base = import.meta.env.BASE_URL;
const home = lang === "zh" ? `${base}zh/` : base;
---
<footer class="site-footer">
  <div class="wrap">
    <div class="about">
      <p class="brand"><span class="brand-mark" aria-hidden="true">AI</span>{t.siteName}</p>
      <p class="tagline">{t.tagline}</p>
      <p class="colophon">{t.colophon}</p>
    </div>
    <nav class="links" aria-label="Footer">
      <a href={home}>{t.home}</a>
      <a href={`${home}#archive`}>{t.archive}</a>
      <a href={`${base}about/`}>{t.about}</a>
      <a href={`${base}rss.xml`}>RSS</a>
      <a href={siteConfig.links.github} target="_blank" rel="noreferrer">GitHub</a>
    </nav>
  </div>
  <div class="wrap bottom">
    <span>© {new Date().getFullYear()} {t.siteName}</span>
    <a href="#top" class="top">{t.backToTop} ↑</a>
  </div>
</footer>

<style>
  .site-footer { margin-top: 4rem; border-top: 1px solid hsl(var(--border)); }
  .wrap { max-width: var(--page-width); margin: 0 auto; padding: 2.5rem var(--gutter) 0; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem 4rem; }
  .brand { margin: 0 0 0.6rem; display: flex; align-items: center; gap: 0.5rem; font-weight: 700; font-size: 1rem; }
  .brand-mark { width: 22px; height: 22px; border-radius: 7px; background: hsl(var(--accent-ink)); color: #fff; display: grid; place-items: center; font-size: 0.58rem; font-weight: 800; }
  .tagline { margin: 0; max-width: 34rem; font-size: 0.9rem; line-height: 1.7; color: hsl(var(--foreground) / 0.8); }
  .colophon { margin: 0.6rem 0 0; max-width: 34rem; font-size: 0.8rem; line-height: 1.7; color: hsl(var(--muted-foreground)); }
  .links { display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.88rem; }
  .links a { color: hsl(var(--muted-foreground)); text-decoration: none; }
  .links a:hover { color: hsl(var(--foreground)); }
  .bottom { padding: 1.5rem var(--gutter) 1.75rem; display: flex; justify-content: space-between; font-size: 0.78rem; color: hsl(var(--muted-foreground)); }
  .top { color: inherit; text-decoration: none; }
  .top:hover { color: hsl(var(--foreground)); }
  @media (max-width: 640px) {
    .wrap { grid-template-columns: 1fr; gap: 1.5rem; }
    .links { flex-direction: row; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
  }
</style>
