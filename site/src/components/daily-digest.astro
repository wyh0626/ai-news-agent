---
/**
 * Grok 来稿日报（digestItems 格式）。
 * 每条一张卡：标题 → 摘要 → 原帖截图 → 可展开的完整报道 → 信源。
 */
import type { CollectionEntry } from "astro:content";
import SourceLinks from "@/components/issue/source-links.astro";
import { hostLabel, paragraphs, ui, type Lang } from "@/lib/issue";

type Data = CollectionEntry<"blog">["data"];
type Props = { items: NonNullable<Data["digestItems"]>; lang: Lang;
  projects?: Data["githubProjects"]; windowStart?: string; windowEnd?: string; supplementCount?: number };
const { items, lang, projects = [], windowStart, windowEnd, supplementCount = 0 } = Astro.props;
const t = ui(lang);
const windowLabel = windowStart && windowEnd
  ? `${windowStart.slice(0, 10)} 08:00 — ${windowEnd.slice(0, 10)} 08:00 (UTC+8)`
  : t.receipt;
const base = import.meta.env.BASE_URL;
const imageUrl = (src: string) => base + src.replace(/^\//, "");
const sourcesOf = (item: Props["items"][number]) => {
  const list = item.sources.map((s) => ({ label: s.label, url: s.url }));
  if (item.tweetUrl && !list.some((s) => s.url === item.tweetUrl)) list.push({ label: hostLabel(item.tweetUrl) || "X", url: item.tweetUrl });
  return list;
};
---
<section class="digest" aria-label={lang === "zh" ? "每日资讯" : "Daily news"}>
  <p class="note">{windowLabel}</p>
  {supplementCount > 0 && <p class="note">{lang === "zh" ? `本期另补入 ${supplementCount} 条资讯。` : `This issue includes ${supplementCount} supplemental stories.`}</p>}
  {items.length === 0 && <p class="note">{lang === "zh" ? "本期没有新增新闻来稿。" : "No new news submissions in this issue."}</p>}
  <ol class="stories">
    {items.map((item, i) => (
      <li class="card" id={`news-${item.id}`}>
        <span class="tag">{String(i + 1).padStart(2, "0")}</span>
        <h2>{item.tweetUrl || item.sources[0] ? <a href={item.tweetUrl ?? item.sources[0].url} target="_blank" rel="noopener noreferrer">{item.title}</a> : item.title}</h2>
        <p class="summary">{item.summary}</p>
        {item.image && (
          <figure class="shot">
            <a href={imageUrl(item.image)} target="_blank" rel="noopener noreferrer" aria-label={t.viewShot}>
              <img src={imageUrl(item.image)} alt={t.screenshot} loading="lazy" decoding="async" />
            </a>
            <figcaption>{t.screenshot} · <a href={imageUrl(item.image)} target="_blank" rel="noopener noreferrer">{t.viewShot} ↗</a></figcaption>
          </figure>
        )}
        {item.body && item.body.trim() && (
          <details class="report">
            <summary>{t.readFull}</summary>
            <div class="report-body">{paragraphs(item.body).map((p) => <p>{p}</p>)}</div>
          </details>
        )}
        {item.uncertainties?.length > 0 && (
          <aside class="caveats">
            <p class="caveats-title">{t.caveats}</p>
            <ul>{item.uncertainties.map((u) => <li>{u}</li>)}</ul>
          </aside>
        )}
        <footer class="meta">
          <SourceLinks sources={sourcesOf(item)} max={4} />
          <span class="published">{t.published} {item.publishedAt || item.publishedDate || t.unknownTime}</span>
        </footer>
      </li>
    ))}
  </ol>
  {projects.length > 0 && (
    <section class="projects" id="github-projects">
      <h2>{lang === "zh" ? "GitHub 开源项目" : "GitHub projects"}</h2>
      <p class="note">{lang === "zh" ? "来自 GitHub Trending，保留项目原文简介。上榜不代表项目当天发布。" : "From GitHub Trending, with original project descriptions. Trending does not imply a new release."}</p>
      <ul class="stories">
        {projects.map((project) => (
          <li class="card">
            <h3><a href={project.url} target="_blank" rel="noopener noreferrer">{project.name} ↗</a></h3>
            <p class="summary">{project.description}</p>
          </li>
        ))}
      </ul>
    </section>
  )}
</section>

<style>
  .note { margin: 0 0 1rem; font-size: 0.78rem; color: hsl(var(--muted-foreground)); }
  .projects { margin-top: 2rem; }
  .projects h3 { margin: 0 0 0.6rem; overflow-wrap: anywhere; }
  .projects h3 a { color: inherit; text-decoration: none; }
  .projects h3 a:hover { color: hsl(var(--accent-ink)); }
  .stories { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .card { padding: 1.4rem 1.5rem; background: hsl(var(--muted)); border-radius: 18px; scroll-margin-top: 5rem; }
  .tag { display: inline-block; font-size: 0.72rem; font-weight: 700; color: hsl(var(--accent-ink)); letter-spacing: 0.04em; margin-bottom: 0.6rem; font-variant-numeric: tabular-nums; }
  h2 { margin: 0 0 0.6rem; font-size: 1.3rem; font-weight: 700; line-height: 1.4; letter-spacing: -0.01em; }
  h2 a { color: inherit; text-decoration: none; }
  h2 a:hover { color: hsl(var(--accent-ink)); }
  .summary { margin: 0 0 1rem; font-size: 0.95rem; line-height: 1.8; color: hsl(var(--foreground) / 0.82); }

  .shot { margin: 0 0 1rem; }
  .shot a { display: block; }
  .shot img { display: block; width: 100%; max-height: 420px; object-fit: contain; background: #fff; border-radius: 12px; border: 1px solid hsl(var(--border)); }
  .shot figcaption { margin-top: 0.5rem; font-size: 0.74rem; color: hsl(var(--muted-foreground)); }
  .shot figcaption a { color: inherit; }

  .report { margin: 0 0 1rem; }
  .report summary { cursor: pointer; list-style: none; display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.86rem; font-weight: 600; color: hsl(var(--accent-ink)); }
  .report summary::-webkit-details-marker { display: none; }
  .report summary::before { content: ""; width: 0.4rem; height: 0.4rem; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(-45deg); transition: transform 0.15s ease; }
  .report[open] summary::before { transform: rotate(45deg); }
  .report-body { margin-top: 0.75rem; padding: 0.9rem 1rem; background: hsl(var(--background)); border-radius: 12px; }
  .report-body p { margin: 0 0 0.9rem; font-size: 0.93rem; line-height: 1.8; color: hsl(var(--foreground) / 0.85); overflow-wrap: anywhere; }
  .report-body p:last-child { margin-bottom: 0; }

  .caveats { margin: 0 0 1rem; padding: 0.75rem 1rem; border-left: 3px solid hsl(var(--accent-ink) / 0.5); font-size: 0.85rem; line-height: 1.7; }
  .caveats-title { margin: 0 0 0.2rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; color: hsl(var(--muted-foreground)); }
  .caveats ul { margin: 0; padding-left: 1.1rem; color: hsl(var(--foreground) / 0.8); }

  .meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.4rem 1rem; align-items: baseline; }
  .published { font-size: 0.72rem; color: hsl(var(--muted-foreground)); overflow-wrap: anywhere; }

  @media (max-width: 640px) { .card { padding: 1.2rem 1.25rem; } h2 { font-size: 1.18rem; } .shot img { max-height: 320px; } }
</style>
