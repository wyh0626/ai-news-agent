---
import type { CollectionEntry } from "astro:content";
import { issueDate, issueTotal, parseIssue, ui, type Lang } from "@/lib/issue";

type Post = CollectionEntry<"blog">;
type Props = { posts: Post[]; lang: Lang; currentSlug?: string };
const { posts, lang, currentSlug } = Astro.props;
const t = ui(lang);
const base = import.meta.env.BASE_URL;

function headlines(post: Post): { heads: string[]; total: number } {
  if (post.data.digestItems?.length) {
    return { heads: post.data.digestItems.slice(0, 3).map((i) => i.title), total: post.data.digestItems.length };
  }
  const issue = parseIssue(post.body);
  const heads = issue.focus.map((s) => s.title).filter(Boolean).slice(0, 3);
  if (heads.length === 0) {
    for (const section of issue.sections) for (const item of section.items) if (item.title && heads.length < 3) heads.push(item.title);
  }
  if (heads.length === 0 && post.data.description) heads.push(post.data.description);
  return { heads, total: issueTotal(issue) };
}

const groups = new Map<string, { post: Post; heads: string[]; total: number }[]>();
for (const post of posts) {
  const key = issueDate(post.data.pubDate, lang).month;
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push({ post, ...headlines(post) });
}
const months = [...groups.entries()];
---
<section id="archive" class="archive" aria-label={t.archive}>
  <h3 class="section-title">{t.archive}<span class="count">{t.issues(posts.length)}</span></h3>
  {months.map(([month, rows], index) => (
    <details class="month" open={index === 0}>
      <summary>
        <span class="month-name">{month}</span>
        <span class="month-count">{t.issues(rows.length)}</span>
      </summary>
      <ol class="rows">
        {rows.map(({ post, heads, total }) => {
          const d = issueDate(post.data.pubDate, lang);
          const isCurrent = post.slug === currentSlug;
          return (
            <li>
              <a href={`${base}blog/${post.slug}/`} class:list={["row", { current: isCurrent }]} aria-current={isCurrent ? "page" : undefined}>
                <time datetime={d.iso} class="date">
                  <span class="date-day">{d.short}</span>
                  <span class="date-weekday">{d.weekdayShort}</span>
                </time>
                <span class="heads">
                  {heads.map((h, i) => <span class="head">{i > 0 && <span class="dot" aria-hidden="true">·</span>}{h}</span>)}
                </span>
                {total > 0 && <span class="total">{total}</span>}
              </a>
            </li>
          );
        })}
      </ol>
    </details>
  ))}
</section>

<style>
  .archive { margin-top: 3rem; }
  .section-title { margin: 0 0 1rem; font-size: 1.1rem; font-weight: 800; display: flex; align-items: center; gap: 0.5rem; }
  .section-title::before { content: ""; width: 4px; height: 1em; border-radius: 2px; background: hsl(var(--accent-ink)); }
  .count { margin-left: auto; font-size: 0.8rem; font-weight: 500; color: hsl(var(--muted-foreground)); }
  .month + .month { margin-top: 0.5rem; }
  summary { list-style: none; cursor: pointer; display: flex; align-items: baseline; gap: 0.75rem; padding: 0.75rem 0.9rem; margin: 0 -0.9rem; border-radius: 12px; font-size: 1rem; font-weight: 700; }
  summary:hover { background: hsl(var(--muted)); }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: "+"; width: 1rem; color: hsl(var(--muted-foreground)); font-weight: 500; }
  details[open] summary::before { content: "–"; }
  .month-count { font-size: 0.78rem; font-weight: 500; color: hsl(var(--muted-foreground)); }
  .rows { list-style: none; margin: 0 0 1rem; padding: 0; }
  .row { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr) auto; gap: 0 1rem; align-items: baseline; padding: 0.75rem 0.9rem; margin: 0 -0.9rem; border-radius: 12px; text-decoration: none; color: inherit; }
  .row:hover { background: hsl(var(--muted)); }
  .row:hover .head { color: hsl(var(--foreground)); }
  .row.current .date-day { color: hsl(var(--accent-ink)); }
  .date { display: flex; flex-direction: column; font-variant-numeric: tabular-nums; }
  .date-day { font-weight: 700; font-size: 0.95rem; line-height: 1.2; }
  .date-weekday { font-size: 0.7rem; color: hsl(var(--muted-foreground)); margin-top: 0.1rem; }
  .heads { display: block; font-size: 0.9rem; line-height: 1.65; color: hsl(var(--foreground) / 0.75); transition: color 0.15s ease; }
  .head { display: inline; }
  .dot { margin: 0 0.45rem; color: hsl(var(--muted-foreground)); }
  .total { font-size: 0.75rem; color: hsl(var(--muted-foreground)); font-variant-numeric: tabular-nums; }
  @media (max-width: 640px) {
    .row { grid-template-columns: 3.8rem minmax(0, 1fr); }
    .total { display: none; }
    .heads { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  }
</style>
