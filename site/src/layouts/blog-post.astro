---
import IssueShell from "@/components/issue/issue-shell.astro";
import type { Lang } from "@/lib/issue";
import { issueMetadata } from "@/lib/seo";
import type { CollectionEntry } from "astro:content";
import MainLayout from "./main-layout.astro";

type Post = CollectionEntry<"blog">;
type Neighbor = { slug: string; date: Date } | null;
type Props = {
  post: Post;
  recent: Post[];
  total?: number | null;
  focusCount?: number;
  nav: { href: string; label: string }[];
  prev?: Neighbor;
  next?: Neighbor;
  pairSlug?: string;
};

const { post, recent, total, focusCount, nav, prev = null, next = null, pairSlug } = Astro.props;
const { pubDate } = post.data;
const lang = (post.data.lang === "zh" ? "zh" : "en") as Lang;
const base = import.meta.env.BASE_URL;
const { title: pageTitle, description } = issueMetadata(post);
const alternateHref = pairSlug ? `${base}blog/${pairSlug}/` : undefined;
const switchHref = pairSlug ? `${base}blog/${pairSlug}/` : lang === "zh" ? base : `${base}zh/`;
---

<MainLayout title={pageTitle} description={description} lang={lang} switchHref={switchHref} alternateHref={alternateHref}>
  <IssueShell lang={lang} date={pubDate} total={total ?? null} focusCount={focusCount} recent={recent} currentSlug={post.slug} nav={nav} prev={prev} next={next}>
    <slot />
  </IssueShell>
</MainLayout>
