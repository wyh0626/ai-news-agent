---
import SiteFooter from "@/components/layout/site-footer.astro";
import SiteHeader from "@/components/layout/site-header.astro";
import { ui, type Lang } from "@/lib/issue";
import { cn } from "@/lib/utils";
import BaseLayout from "./base-layout.astro";

type Props = {
  title: string;
  description?: string;
  mainClass?: string;
  lang?: Lang;
  /** 切换到另一种语言时去哪里；不传就不显示切换按钮 */
  switchHref?: string;
};

const { title, description, mainClass, lang = "en", switchHref } = Astro.props;
---

<BaseLayout title={title} description={description} lang={lang} siteName={ui(lang).siteName}>
  <SiteHeader lang={lang} switchHref={switchHref} />
  <main class={cn("flex-1", mainClass)}>
    <slot />
  </main>
  <SiteFooter lang={lang} />
</BaseLayout>
