---
import BaseHead from "@/components/layout/base-head.astro";
import { cn } from "@/lib/utils";

type Props = {
  title: string;
  description?: string;
  bodyClass?: string;
  lang?: string;
  siteName?: string;
};

const { title, description, bodyClass, lang = "en", siteName } = Astro.props;
---

<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : lang} class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} siteName={siteName} />
  </head>
  <body class={cn("flex flex-col min-h-screen", bodyClass)}>
    <slot />
  </body>
</html>
