---
import Home from "@/components/home.astro";
import MainLayout from "@/layouts/main-layout.astro";
import { getPosts, getZhPosts } from "@/lib/fetchers";
import { ui } from "@/lib/issue";

const zhPosts = await getZhPosts();
// 没有中文版时退回英文
const posts = zhPosts.length > 0 ? zhPosts : await getPosts();
const base = import.meta.env.BASE_URL;
const t = ui("zh");
---

<MainLayout title="" description={t.tagline} lang="zh" switchHref={base}>
  {/* 语言偏好记录：用户访问中文页即视为选择了中文 */}
  <script is:inline>
    try { localStorage.setItem('ai-daily-lang', 'zh'); } catch (e) {}
  </script>
  <Home posts={posts} lang="zh" />
</MainLayout>
