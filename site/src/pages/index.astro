---
import Home from "@/components/home.astro";
import MainLayout from "@/layouts/main-layout.astro";
import { getPosts } from "@/lib/fetchers";

const posts = await getPosts();
const base = import.meta.env.BASE_URL;
---

<MainLayout
  title="AI News, Model Releases & Open-Source Projects"
  description="Daily AI news covering model releases, coding tools, AI agents, research and GitHub projects. Read clear summaries and full reports with original sources."
  lang="en" switchHref={`${base}zh/`} alternateHref={`${base}zh/`}
>
  <Home posts={posts} lang="en" />
</MainLayout>
